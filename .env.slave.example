# Separate host worker, NOT a conference environment. Use as an initialization
# template, outside the root's .env.* discovery, NOT over an existing worker.env.
# First setup: python3 scripts/deploy.py worker --init [--gpu] --template <template-file> --client <conference-project>
# Update: python3 scripts/deploy.py worker [--gpu] --env-file runtime/comparison-slave/worker.env
# Historical start_comparison_slave.py CLI delegates to this same lifecycle.
# Add --gpu only for a configured NVIDIA host. Never combine with docker-compose.yml.
CFM_SLAVE_PROJECT_NAME=cfm-comparison-slave
CFM_COMPARISON_NETWORK=cfm-comparison
CFM_SLAVE_BIND_HOST=127.0.0.1
CFM_SLAVE_PORT=8091
CFM_SLAVE_MEMORY_LIMIT=8g
CFM_SLAVE_MODEL_DIR=./runtime/rapidocr-models
CFM_SLAVE_CLIENTS_SOURCE=./runtime/comparison-slave/clients.json
CFM_RAPIDOCR_THREADS=4
# Omit PAGES to use the backend default: CPU 2, GPU 4.
# Existing explicit values are retained on deployment/update.
# CFM_RAPIDOCR_PAGES=4
CFM_RAPIDOCR_DET_MODEL=small
CFM_RAPIDOCR_REC_MODEL=small
CFM_RAPIDOCR_TIMEOUT=300

# GPU override only: NVIDIA host device index or UUID; container uses device 0.
CFM_SLAVE_GPU_DEVICE=0
# GPU models unload after this many idle seconds. 0 disables residency.
# CPU ignores this option. Existing explicit values are never overwritten.
# CFM_GPU_MODEL_IDLE_SECONDS=1800
