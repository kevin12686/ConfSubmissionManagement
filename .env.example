# Copy this file to one file per conference, for example:
#   cp .env.example .env.conference-a
#
# Preferred setup: python3 scripts/deploy.py conference --name conference-a --port 8000
# Existing env: use the deployer's --env-file option; do not overwrite this file.

# Stable Compose project name. The unified Docker updater uses this value to
# match this env file to the correct running conference instance.
COMPOSE_PROJECT_NAME=sms-conf-a

# Host port for this conference instance.
SMS_PORT=8000

# Bind to 127.0.0.1 for local-only access. Use 0.0.0.0 only on a trusted machine
# if another computer on the network must reach the app.
SMS_BIND_HOST=127.0.0.1

# Host mirror for this conference's SQLite database and managed files.
# Docker runs from a project-scoped named volume. Run
# scripts/backup_docker_instances.py to refresh this directly usable mirror.
SMS_DATA_DIR=./runtime/conference-a

# Keep this distinct per machine or deployment if the app is exposed beyond localhost.
SMS_SECRET_KEY=change-me-for-this-local-docker-instance

# Add the machine's LAN hostname or IP here if SMS_BIND_HOST=0.0.0.0.
SMS_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Keep Django debug disabled for normal Docker operation. Nginx serves static
# and media files in both modes, so this setting only controls Django's debug
# diagnostics.
SMS_DEBUG=0

# Maximum total HTTP request body accepted by the Docker Nginx proxy. Keep this
# finite; lower it if the conference never uploads very large PDF/source batches.
SMS_PROXY_MAX_BODY_SIZE=10g

# OCR threads per comparison (1-8). Match Docker's allocated CPU capacity;
# raising this does not change resolution/models or extend the 240-second limit.
CFM_RAPIDOCR_THREADS=4

# Compose uses the separately deployed shared comparison worker by default.
# Native launchers default to embedded unless transport is explicitly service.
# Service mode never silently falls back to embedded OCR. Configure separate
# per-conference bearer tokens for each endpoint; blank tokens are unavailable.
CFM_COMPARISON_TRANSPORT=service
# Start the shared slave first; it creates this external Docker network.
CFM_COMPARISON_NETWORK=cfm-comparison
CFM_COMPARISON_LOCAL_URL=http://comparison-slave:8091
# Leave LOCAL_URL and LOCAL_TOKEN explicitly blank only for remote-only service mode.
CFM_COMPARISON_LOCAL_TOKEN=
CFM_COMPARISON_REMOTE_URL=
CFM_COMPARISON_REMOTE_TOKEN=

# Optional CrossCheck credentials. Usually leave all blank and use the service's
# default IEEE account. Nonempty environment values override local UI secrets.
SMS_CROSSCHECK_WEB_USERNAME=
SMS_CROSSCHECK_WEB_PASSWORD=
SMS_CROSSCHECK_IEEE_USERNAME=
SMS_CROSSCHECK_IEEE_PASSWORD=
